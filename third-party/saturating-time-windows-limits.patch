+    /// A clock counting 100ns ticks in an `i64`, like Windows' `SystemTime`,
+    /// that truncates sub-tick durations instead of rejecting them.
+    #[derive(Clone, Copy, Debug, PartialEq)]
+    struct CoarseClock(i64);
+
+    impl CoarseClock {
+        /// Converts `duration` to whole ticks, truncating like Windows does.
+        fn ticks(duration: Duration) -> Option<i64> {
+            i64::try_from(duration.as_nanos() / 100).ok()
+        }
+    }
+
+    impl SaturatingTime for CoarseClock {
+        fn anchor() -> Self {
+            Self(0)
+        }
+
+        fn max_value() -> Self {
+            find_max()
+        }
+
+        fn min_value() -> Self {
+            find_min()
+        }
+
+        fn checked_add(&self, duration: Duration) -> Option<Self> {
+            self.0.checked_add(Self::ticks(duration)?).map(Self)
+        }
+
+        fn checked_sub(&self, duration: Duration) -> Option<Self> {
+            self.0.checked_sub(Self::ticks(duration)?).map(Self)
+        }
+
+        fn checked_duration_since(&self, _earlier: Self) -> Option<Duration> {
+            unreachable!()
+        }
+    }
+
+    /// Limits are found, and found exactly, on clocks coarser than 1ns.
+    #[test]
+    fn coarse_clock_limits_terminate() {
+        assert_eq!(CoarseClock::max_value(), CoarseClock(i64::MAX));
+        assert_eq!(CoarseClock::min_value(), CoarseClock(i64::MIN));
+    }
+
