+// GENORYN downstream safety correction: the native API documents NULL on failure.
+fn checked_vm_pointer(vm: *mut randomx_vm) -> Result<*mut randomx_vm, RandomXError> {
+    if vm.is_null() {
+        Err(RandomXError::CreationError("Failed to allocate VM".to_string()))
+    } else {
+        Ok(vm)
+    }
+}
