{
	auto_https disable_redirects
	# The client's address is taken from CF-Connecting-IP only when the request comes from
	# Cloudflare (whose ranges these are, as in the firewall); from anywhere else it is the
	# connection's own address, so a forged header is never believed.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(site) {
	@www host www.genoryn.io
	redir @www https://genoryn.io{uri} 301
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	# Small JSON requests everywhere except transactions, JSON-RPC and sell offers (proofs
	# are large).
	@small not path /v1/tx /rpc /v1/swap/offers
	request_body @small {
		max_size 64KB
	}
	request_body /v1/tx {
		max_size 8MB
	}
	# A sell offer carries its proof of funds: a transfer of about 100 KB, in hex.
	request_body /v1/swap/offers {
		max_size 512KB
	}
	# The BTC price in dollars for the GNR market price, fetched by this server so visitors'
	# browsers never contact a third party (connect-src stays 'self').
	handle /v1/btc-price {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		header Cache-Control "public, max-age=120"
		rewrite * /api/v1/prices
		reverse_proxy https://mempool.space {
			header_up Host mempool.space
			# Nothing about the visitor goes to mempool.space.
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
			header_up -CF-Connecting-IPv6
			header_up -CF-IPCountry
			header_up -CF-Ray
			header_up -CF-Visitor
			header_up -CDN-Loop
			header_up -True-Client-IP
			header_up -Cookie
			header_up -Referer
			header_up -Origin
			header_up -Accept-Language
			header_up User-Agent genoryn.io
		}
	}
	# Public node API for light wallets, explorers and miners (mainnet; testnet would be 31334).
	@api path /v1/* /rpc
	handle @api {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy 127.0.0.1:30334 {
			flush_interval -1
			# The client's address (see trusted_proxies above); the node budgets requests by it.
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}
	# Genoryn Talks, the community forum and live chat: a service of its own on this
	# machine. It sets its own security headers and budgets requests by the client address.
	@talks path /talks /talks/*
	handle @talks {
		reverse_proxy 127.0.0.1:30400 {
			flush_interval -1
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}
	handle {
		# Clean addresses: /market, not /market.html (old links move permanently).
		redir /coins /tokens 301
		@index path /index.html
		redir @index / 301
		@html {
			path_regexp html ^/([a-z0-9-]+)\.html$
			expression {query} == ""
		}
		redir @html /{re.html.1} 301
		@htmlq {
			path_regexp htmlq ^/([a-z0-9-]+)\.html$
			expression {query} != ""
		}
		redir @htmlq /{re.htmlq.1}?{query} 301
		root * /var/www/genoryn-krypton
		header /assets/* Cache-Control "public, max-age=604800"
		# Files crawlers and language models read: refreshed within the hour after a change.
		@crawl path /robots.txt /sitemap.xml /llms.txt /llms-full.txt
		header @crawl Cache-Control "public, max-age=3600"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		try_files {path} {path}.html
		file_server
	}
	# An address that does not exist answers 404 with a helpful page, never the home page
	# (search engines treat a 200 for every address as a broken site).
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			root * /var/www/genoryn-krypton
			rewrite * /404.html
			header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			file_server
		}
		handle {
			respond "{err.status_code} {err.status_text}" {err.status_code}
		}
	}
}

# Behind Cloudflare in "Full" mode: Cloudflare terminates the public certificate.
https://genoryn.io, https://www.genoryn.io {
	tls internal
	import site
}

# Plain HTTP only sends visitors to HTTPS: neither the site nor the node API is ever served
# unencrypted (Cloudflare reaches this origin over HTTPS).
http://genoryn.io, http://www.genoryn.io, :80 {
	redir https://genoryn.io{uri} 308
}
