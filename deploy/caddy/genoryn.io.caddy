{
	auto_https disable_redirects
}

(site) {
	@www host www.genoryn.io
	redir @www https://genoryn.io{uri} 301
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	# Small JSON requests everywhere except transactions and JSON-RPC (proofs are large).
	@small not path /v1/tx /rpc
	request_body @small {
		max_size 64KB
	}
	request_body /v1/tx {
		max_size 8MB
	}
	# The BTC price in dollars for the GNR market price, fetched by this server so visitors'
	# browsers never contact a third party (connect-src stays 'self').
	handle /v1/btc-price {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		header Cache-Control "public, max-age=120"
		rewrite * /api/v1/prices
		reverse_proxy https://mempool.space {
			header_up Host mempool.space
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
			header_up -Cookie
		}
	}
	# Public node API for light wallets, explorers and miners (mainnet; testnet would be 31334).
	@api path /v1/* /rpc
	handle @api {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy 127.0.0.1:30334 {
			flush_interval -1
			# The origin accepts web traffic only from Cloudflare (firewall), so the client
			# address Cloudflare reports is trustworthy; the node budgets requests by it.
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		# Clean addresses: /market, not /market.html (old links move permanently).
		@index path /index.html
		redir @index / 301
		@html {
			path_regexp html ^/([a-z0-9-]+)\.html$
			expression {query} == ""
		}
		redir @html /{re.html.1} 301
		@htmlq {
			path_regexp htmlq ^/([a-z0-9-]+)\.html$
			expression {query} != ""
		}
		redir @htmlq /{re.htmlq.1}?{query} 301
		root * /var/www/genoryn-krypton
		header /assets/* Cache-Control "public, max-age=604800"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		try_files {path} {path}.html /index.html
		file_server
	}
}

# Behind Cloudflare in "Full" mode: Cloudflare terminates the public certificate.
https://genoryn.io, https://www.genoryn.io {
	tls internal
	import site
}

# Plain HTTP only sends visitors to HTTPS: neither the site nor the node API is ever served
# unencrypted (Cloudflare reaches this origin over HTTPS).
http://genoryn.io, http://www.genoryn.io, :80 {
	redir https://genoryn.io{uri} 308
}
